@REM Maven Wrapper Windows Script
@REM

@IF "%__MVNW_ARG0_NAME__%"=="mvnw" (EXIT /B 0)
@SET __MVNW_ARG0_NAME__=mvnw
@SET __MAVEN_CMD__=
@SET __MAVEN_WRAPPER_JAR__=%~dp0.mvn\wrapper\maven-wrapper.jar
@SET __MAVEN_WRAPPER_PROPS__=%~dp0.mvn\wrapper\maven-wrapper.properties

@java -jar "%__MAVEN_WRAPPER_JAR__%" %*
@EXIT /B %ERRORLEVEL%
