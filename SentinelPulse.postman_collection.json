{
  "info": {
    "_postman_id": "sentinelpulse-edge-gateway-v1",
    "name": "SentinelPulse — Edge Infrastructure & Webhook Dispatcher",
    "description": "Complete test suite for SentinelPulse API Gateway, Reverse Proxy, Token-Bucket Rate Limiter, Webhook Dispatcher, Idempotency Engine, and Telemetry.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "apiKey",
      "value": "sentinel-dev-key-001",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 - Health & Infrastructure",
      "item": [
        {
          "name": "Actuator Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/actuator/health",
              "host": ["{{baseUrl}}"],
              "path": ["actuator", "health"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Application and Redis are UP', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.status).to.eql('UP');",
                  "    pm.expect(json.components.redis.status).to.eql('UP');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Prometheus Metrics Scraping",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/actuator/prometheus",
              "host": ["{{baseUrl}}"],
              "path": ["actuator", "prometheus"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response contains SentinelPulse custom metrics', function () {",
                  "    pm.expect(pm.response.text()).to.include('sentinelpulse_requests_total');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 - Security & Authentication",
      "item": [
        {
          "name": "Reject Missing API Key (401)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/orders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "orders"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 401 Unauthorized', function () {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "pm.test('Returns JSON error message', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.status).to.eql(401);",
                  "    pm.expect(json.error).to.eql('Unauthorized');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Reject Invalid API Key (401)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "invalid-random-secret-key",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/orders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "orders"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 401 Unauthorized', function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03 - Reverse Proxy & Route Caching",
      "item": [
        {
          "name": "Forward Request via Reverse Proxy",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/orders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "orders"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Proxied successfully (200) or Downstream offline (502)', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 502]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Prefix Route Matching Subpath",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/orders/ORD-101",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "orders", "ORD-101"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Matched route by prefix fallback', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 502]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Unmapped Route (404 Not Found)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/nonexistent-service",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "nonexistent-service"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 404 Not Found', function () {",
                  "    pm.response.to.have.status(404);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Method Not Allowed (405)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/inventory",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "inventory"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 405 Method Not Allowed', function () {",
                  "    pm.response.to.have.status(405);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "04 - Webhook Subscribers",
      "item": [
        {
          "name": "Register New Subscriber (201 Created)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"subscriber_id\": \"postman-sub-001\",\n  \"target_url\": \"http://localhost:9999/webhook\",\n  \"event_type\": \"order.completed\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/subscribers",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "subscribers"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created or 200 OK', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "pm.test('Response contains registered subscriber metadata', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.subscriber_id).to.eql('postman-sub-001');",
                  "    pm.expect(json.event_type).to.eql('order.completed');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Update Existing Subscriber (200 OK)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"subscriber_id\": \"postman-sub-001\",\n  \"target_url\": \"http://localhost:9999/webhook-updated\",\n  \"event_type\": \"order.completed\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/subscribers",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "subscribers"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK on update', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Invalid Protocol Validation (400 Bad Request)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"subscriber_id\": \"sub-invalid\",\n  \"target_url\": \"ftp://invalid.com/file\",\n  \"event_type\": \"order.completed\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/subscribers",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "subscribers"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 400 Bad Request', function () {",
                  "    pm.response.to.have.status(400);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "05 - Webhook Event Intake & Fan-out",
      "item": [
        {
          "name": "Ingest Webhook Event (202 Accepted)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_type\": \"order.completed\",\n  \"source\": \"order-service\",\n  \"data\": {\n    \"order_id\": \"ORD-PM-{{$timestamp}}\",\n    \"amount\": 349.50,\n    \"currency\": \"USD\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/events",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "events"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 202 Accepted', function () {",
                  "    pm.response.to.have.status(202);",
                  "});",
                  "pm.test('Response confirms asynchronous dispatch initiated', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.status).to.eql(202);",
                  "    pm.expect(json.event_type).to.eql('order.completed');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Idempotency Deduplication (409 Conflict)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_type\": \"order.completed\",\n  \"source\": \"order-service\",\n  \"data\": {\n    \"order_id\": \"ORD-STATIC-IDEMPOTENT-100\",\n    \"amount\": 99.00\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/events",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "events"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Initial submission returns 202 or Duplicate returns 409', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([202, 409]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "No Matching Subscribers (404 Not Found)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_type\": \"user.password_reset\",\n  \"source\": \"auth-service\",\n  \"data\": {\n    \"user_id\": \"USR-009\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/events",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "events"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 404 when no subscribers exist', function () {",
                  "    pm.response.to.have.status(404);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "06 - Rate Limiting & Throttling",
      "item": [
        {
          "name": "Rate Limit Bucket Exhaustion (429)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/orders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "orders"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 429) {",
                  "    pm.test('Returns 429 Too Many Requests', function () {",
                  "        pm.response.to.have.status(429);",
                  "    });",
                  "    pm.test('Contains Retry-After header', function () {",
                  "        pm.expect(pm.response.headers.has('Retry-After')).to.be.true;",
                  "    });",
                  "} else {",
                  "    pm.test('Token consumed within bucket capacity', function () {",
                  "        pm.expect(pm.response.code).to.be.oneOf([200, 502]);",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    }
  ]
}
